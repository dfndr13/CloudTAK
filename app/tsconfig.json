{
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@tak-ps/cloudtak": [
        "./plugin.ts"
      ],
      "@cloudtak/api-types": [
        "../api/derived-types.d.ts"
      ]
    },
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "noImplicitThis": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": [
      "dom",
      "esnext",
      "webworker"
    ],
    "types": [
      "vite/client"
    ],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "plugins",
    "plugin.ts",
    "shims-vue.d.ts",
    "vite.config.ts"
  ],
  "exclude": [
    "plugins/livewx-radar",
    "plugins/replay",
    "plugins/simulator",
    "plugins/tak-dispatcher"
  ]
}
